{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // scripts/ runs under plain Node in CI, which needs its own modules imported by their .ts name (#351).
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "*.mts"],
  "exclude": ["node_modules"]
}
